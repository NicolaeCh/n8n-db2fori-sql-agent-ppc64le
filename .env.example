# Service
APP_NAME=n8n-db2-sql-agent
APP_VERSION=1.0.0
LOG_LEVEL=INFO
API_DOCS_ENABLED=true
SQL_AGENT_BIND_ADDRESS=127.0.0.1
SQL_AGENT_PORT=8080
WEB_CONCURRENCY=1

# API authentication. Generate with: openssl rand -hex 32
DB2_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Mapepire server on IBM i
MAPEPIRE_HOST=ibmi.example.com
MAPEPIRE_PORT=8076
MAPEPIRE_USER=N8NDB2
MAPEPIRE_PASSWORD=CHANGE_ME
MAPEPIRE_TLS_VERIFY=true
# MAPEPIRE_CA_PATH=/run/secrets/mapepire-ca.pem

# Local SQLJob pool. With WEB_CONCURRENCY=1 this creates four IBM i jobs.
MAPEPIRE_POOL_ENABLED=true
MAPEPIRE_POOL_SIZE=4
MAPEPIRE_POOL_WAIT_SECONDS=30
MAPEPIRE_QUERY_TRACE_ENABLED=false
MAPEPIRE_SLOW_QUERY_MS=750

# SQL policy
SQL_ALLOWED_READ_SCHEMAS=QSYS2,SYSTOOLS,MONAI
SQL_ALLOWED_WRITE_SCHEMA=MONAI
SQL_MAX_LENGTH=65535
SQL_MAX_PARAMETERS=500
SQL_MAX_SELECT_ROWS=1000
# Only these unqualified SQL functions may be invoked. Schema-qualified routines are always rejected.
SQL_ALLOWED_FUNCTIONS=COUNT,SUM,AVG,MIN,MAX,COALESCE,NULLIF,CAST,CHAR,VARCHAR,INTEGER,BIGINT,DECIMAL,DATE,TIME,TIMESTAMP,UPPER,LOWER,TRIM,LTRIM,RTRIM,SUBSTR,SUBSTRING,REPLACE,LENGTH,ABS,ROUND,CEILING,FLOOR,MOD,POWER,SQRT,ROW_NUMBER,RANK,DENSE_RANK,LAG,LEAD
